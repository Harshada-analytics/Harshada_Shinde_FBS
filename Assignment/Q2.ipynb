   "source": [
    "#### Q2 Write code to replace the odd numbers by -1 in the array created by using random.randint( 1 , 50,20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "d61703eb-7f6d-4257-a22b-a7a455246518",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([13, 46,  4, 31, 46,  4, 10, 23,  2, 30, 19, 38, 46, 49,  3, 14,  1,\n",
       "       23, 20, 13], dtype=int32)"
      ]
     },
     "execution_count": 7,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import numpy as np \n",
    "\n",
    "arr = np.random.randint(1,50,20)\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "14babcac-5cba-4180-b960-3fd16b47d663",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([-1, 46,  4, -1, 46,  4, 10, -1,  2, 30, -1, 38, 46, -1, -1, 14, -1,\n",
       "       -1, 20, -1], dtype=int32)"
      ]
     },
     "execution_count": 9,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr[arr % 2 != 0] = -1\n",
    "arr "
   ]
